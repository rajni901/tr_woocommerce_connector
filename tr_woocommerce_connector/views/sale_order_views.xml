<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_woo_form" model="ir.ui.view">
        <field name="name">sale.order.woo.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" class="oe_stat_button" icon="fa-shopping-cart"
                        invisible="not woo_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">WooCommerce</span>
                        <span class="o_stat_value">
                            <field name="woo_order_number"/>
                        </span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="woo_id" invisible="not woo_id" readonly="1"/>
                <field name="woo_backend_id" invisible="not woo_backend_id" readonly="1"/>
                <field name="woo_order_status" invisible="not woo_order_status" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="action_woo_sale_orders" model="ir.actions.act_window">
        <field name="name">WooCommerce Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('woo_id', '!=', False)]</field>
    </record>

</odoo>
