<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_woo_backend_form" model="ir.ui.view">
        <field name="name">woo.backend.form</field>
        <field name="model">woo.backend</field>
        <field name="arch" type="xml">
            <form string="WooCommerce Store">
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object"
                                class="oe_stat_button" icon="fa-cube">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                        <button name="action_view_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_view_logs" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" placeholder="Store Name"/></h1>
                    </div>

                    <!-- Action Buttons -->
                    <div class="o_row mb-3">
                        <button name="action_test_connection" type="object"
                                string="Test Connection" class="btn-primary"/>
                        <button name="action_import_orders" type="object"
                                string="Import Orders" class="btn-secondary"/>
                        <button name="action_export_products" type="object"
                                string="Export Products" class="btn-secondary"/>
                        <button name="action_sync_stock" type="object"
                                string="Sync Stock" class="btn-secondary"/>
                    </div>

                    <group>
                        <group string="Connection">
                            <field name="store_url" placeholder="https://mystore.com"/>
                            <field name="consumer_key" password="True"/>
                            <field name="consumer_secret" password="True"/>
                            <field name="version"/>
                        </group>
                        <group string="Defaults">
                            <field name="company_id"/>
                            <field name="default_warehouse_id"/>
                            <field name="default_pricelist_id"/>
                            <field name="default_lang_id"/>
                        </group>
                    </group>

                    <group string="Sync Settings">
                        <group>
                            <field name="auto_import_orders"/>
                            <field name="auto_sync_stock"/>
                            <field name="order_status_filter"/>
                        </group>
                        <group>
                            <field name="last_order_import" readonly="1"/>
                            <field name="last_stock_sync" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_woo_backend_list" model="ir.ui.view">
        <field name="name">woo.backend.list</field>
        <field name="model">woo.backend</field>
        <field name="arch" type="xml">
            <list string="WooCommerce Stores">
                <field name="name"/>
                <field name="store_url"/>
                <field name="product_count"/>
                <field name="order_count"/>
                <field name="last_order_import"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_woo_backend" model="ir.actions.act_window">
        <field name="name">WooCommerce Stores</field>
        <field name="res_model">woo.backend</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_woo_root" name="WooCommerce" sequence="80"
              web_icon="tr_woocommerce_connector,static/description/icon.png"/>
    <menuitem id="menu_woo_backends" name="Stores"
              parent="menu_woo_root" action="action_woo_backend" sequence="1"/>
    <menuitem id="menu_woo_orders" name="Orders"
              parent="menu_woo_root" sequence="2"
              action="action_woo_sale_orders"/>
    <menuitem id="menu_woo_products" name="Products"
              parent="menu_woo_root" sequence="3"
              action="action_woo_products"/>
    <menuitem id="menu_woo_logs" name="Sync Logs"
              parent="menu_woo_root" sequence="10"
              action="action_woo_logs"/>

</odoo>
