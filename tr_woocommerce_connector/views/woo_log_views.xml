<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_woo_log_list" model="ir.ui.view">
        <field name="name">woo.log.list</field>
        <field name="model">woo.log</field>
        <field name="arch" type="xml">
            <list string="Sync Logs" decoration-danger="status == 'error'"
                  decoration-success="status == 'success'"
                  decoration-warning="status == 'warning'">
                <field name="create_date"/>
                <field name="backend_id"/>
                <field name="operation"/>
                <field name="status"/>
                <field name="woo_id"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_woo_log_search" model="ir.ui.view">
        <field name="name">woo.log.search</field>
        <field name="model">woo.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="operation"/>
                <field name="backend_id"/>
                <filter name="errors" string="Errors" domain="[('status','=','error')]"/>
                <filter name="success" string="Success" domain="[('status','=','success')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_woo_logs" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">woo.log</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
