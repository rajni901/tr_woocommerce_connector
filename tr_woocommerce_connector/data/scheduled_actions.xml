<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cron_woo_import_orders" model="ir.cron">
        <field name="name">WooCommerce: Auto Import Orders</field>
        <field name="model_id" ref="model_woo_backend"/>
        <field name="state">code</field>
        <field name="code">model._cron_import_orders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active">False</field>
    </record>

    <record id="cron_woo_sync_stock" model="ir.cron">
        <field name="name">WooCommerce: Auto Sync Stock</field>
        <field name="model_id" ref="model_woo_backend"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_stock()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active">False</field>
    </record>

</odoo>
